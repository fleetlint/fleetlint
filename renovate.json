{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "pre-commit": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "merged when check passes; a go.mod/go.sum update then becomes a patch release (security-release.yml)",
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "automerge": true,
    "platformAutomerge": false
  },
  "packageRules": [
    {
      "description": "x/ modules carry the HTTP/2 and crypto fixes; govulncheck in CI fails on them even when indirect",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchPackageNames": [
        "golang.org/x/**"
      ],
      "enabled": true
    }
  ]
}
